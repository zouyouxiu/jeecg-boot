<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.demo.mytest.mapper.SubPlatformMapper">

    <select id="selectBatchIds" parameterType="list" resultType="org.jeecg.modules.demo.mytest.entity.SubPlatform">
        SELECT id, name, code, type FROM sub_platform
        WHERE id IN
        <foreach item="item" collection="ids" separator="," open="(" close=")">
            #{item}
        </foreach>
    </select>
</mapper>